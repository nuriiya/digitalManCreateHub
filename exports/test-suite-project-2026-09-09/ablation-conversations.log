def extract_code(reply: str) -> str:
    """从模型回答里提取纯 Python 代码。
    优先提取 ```python ... ``` 代码块；没有代码块则从首个 def/from/import
    开头的行开始截取到结尾；都没有则返回原文。
    """
    import re

    # 检查是否有 ```python ... ``` 代码块
    code_block_match = re.search(r'```python(.*?)```', reply, re.DOTALL)
    if code_block_match:
        return code_block_match.group(1).strip()

    # 检查是否有 def/from/import 开头的行
    lines = reply.split('\n')
    start_index = None
    for i, line in enumerate(lines):
        if line.strip().startswith(('def ', 'from ', 'import ')):
            start_index = i
            break

    if start_index is not None:
        return '\n'.join(lines[start_index:]).strip()

    # 如果没有找到任何代码，返回原文
    return reply.strip()

