    test_cases = [
        ("", 10, 3, []),
        ("hello", 10, 3, ["hello"]),
        ("hello world", 10, 3, ["hello worl", "llo worl", "lo worl", " worl", " world"]),
        ("hello world", 5, 3, ["hello", "llo w", "lo wo", " wo", " world"]),
        ("hello world", 3, 2, ["hel", "ell", "llo", "lo ", " wo", "or", "rl", "ld"]),
    ]

    for text, max_len, overlap, expected in test_cases:
        result = chunk_overlap(text, max_len, overlap)
        assert result == expected, f"Failed for {text} with max_len={max_len}, overlap={overlap}. Expected {expected}, got {result}"

    print("All tests passed!")

