def chunk_overlap(text: str, max_len: int, overlap: int) -> list:
    """把文本切成有重叠的分段。
    每段不超过 max_len 字符；相邻段之间重叠 overlap 个字符；
    最后一段即使很短也要保留。
    """
    if max_len <= 0 or overlap < 0:
        raise ValueError("max_len must be positive and overlap must be non-negative")

    chunks = []
    start = 0
    while start < len(text):
        end = max(start + max_len, len(text))
        if start == 0:
            chunk = text[:end]
        else:
            chunk = text[start - overlap:end]
        chunks.append(chunk)
        start = end - overlap

    return chunks

