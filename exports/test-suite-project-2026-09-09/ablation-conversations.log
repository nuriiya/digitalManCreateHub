def parse_dsn(dsn: str) -> dict:
    """解析 PostgreSQL 连接串，返回 dict。
    格式：postgresql://user:password@host:port/dbname
    端口缺省时默认 5432，密码可为空。
    """
    parts = dsn.split('://', 1)
    if len(parts) != 2:
        raise ValueError("DSN格式不正确")
    
    scheme, rest = parts
    if scheme != 'postgresql':
        raise ValueError("DSN方案不正确")
    
    user_pass, host_db = rest.split('@', 1)
    user, password = user_pass.split(':', 1) if ':' in user_pass else ('', '')
    host, db = host_db.split('/', 1)
    
    port = 5432
    if ':' in host:
        host, port_str = host.split(':', 1)
        try:
            port = int(port_str)
        except ValueError:
            raise ValueError("DSN格式不正确")
    
    return {
        'user': user,
        'password': password,
        'host': host,
        'port': port,
        'dbname': db
    }

