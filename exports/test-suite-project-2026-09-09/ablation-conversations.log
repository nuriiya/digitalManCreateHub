def extract_code(reply: str) -> str:
    """从模型回答里提取纯 Python 代码。
    优先提取 ```python ... ``` 代码块；没有代码块则从首个 def/from/import
    开头的行开始截取到结尾；都没有则返回原文。
    """
    if '```python' in reply:
        start = reply.index('```python') + len('```python')
        end = reply.index('```', start)
        return reply[start:end].strip()
    
    lines = reply.split('\n')
    for i, line in enumerate(lines):
        if line.strip().startswith(('def', 'from', 'import')):
            start = i
            break
    else:
        return reply
    
    end = len(lines)
    return '\n'.join(lines[start:end]).strip()

