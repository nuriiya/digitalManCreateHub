# CN Docker Hub mirror prefixes. Empty = pull straight from Docker Hub names.
# REGISTRY_PREFIX      -> user images (e.g. pgvector/pgvector) in compose
# REGISTRY_LIBRARY_PREFIX -> official images (node/python) in the Dockerfile
#   (official images live under the "library/" namespace on mirrors)
#
# 2026-09-14 (this machine): dockerproxy.net is dead (/v2/ -> 502 through the
# host proxy). Two traps found while bringing the stack up:
#   1. docker.io / registry-1.docker.io are unreachable directly here.
#   2. putting the mirror in dockerd's registry-mirrors does NOT work with
#      Docker 29's containerd snapshotter — it logs "Host doesn't match
#      cfgHost=registry-1.docker.io" and large layers stall at 0 bytes.
# So the mirror is applied as an EXPLICIT image-name prefix instead, which pulls
# fine (~6.2 MB/s measured). docker.m.daocloud.io and docker.1ms.run both work.
REGISTRY_PREFIX=docker.m.daocloud.io/
REGISTRY_LIBRARY_PREFIX=docker.m.daocloud.io/library/

# 外网 LLM 出口代理（宿主机 mihomo 内核 0.0.0.0:6789）。deepseek 直连在当前
# 网络环境 SSL EOF（被墙），必须经宿主代理；GLM 可直连。留空 = 直连。
LLM_PROXY=http://host.docker.internal:6789
