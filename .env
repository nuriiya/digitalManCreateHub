# CN Docker Hub mirror prefixes. Empty = pull straight from Docker Hub.
# REGISTRY_PREFIX      -> user images (e.g. pgvector/pgvector) in compose
# REGISTRY_LIBRARY_PREFIX -> official images (node/python) in the Dockerfile
#   (official images live under the "library/" namespace on mirrors)
# Company mirror (registry.united-imaging.com proxies Docker Hub; verified
# 2026-09-14). Public mirrors such as dockerproxy.net are unreachable here.
REGISTRY_PREFIX=registry.united-imaging.com/
REGISTRY_LIBRARY_PREFIX=registry.united-imaging.com/library/

# Compose project name. Pinned so the same compose files reuse the same
# volumes/network no matter which path they are launched from. ops/wsl_up.sh
# starts from the ~/rag_prototype symlink, whose directory name would
# otherwise be picked as the project name (creating an orphan
# rag_prototype_pg_data volume and colliding with the existing rag_pg
# container name). Set it to the Windows checkout directory name.
COMPOSE_PROJECT_NAME=digitalmancreatehub

# 外网 LLM 出口代理（宿主机 mihomo 内核 0.0.0.0:6789）。deepseek 直连在当前
# 网络环境 SSL EOF（被墙），必须经宿主代理；GLM 可直连。留空 = 直连。
LLM_PROXY=http://host.docker.internal:6789
